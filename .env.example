# ---- Telegram ----
# Токен от @BotFather
BOT_TOKEN=123456:AA...
# Username бота без @ — подставляется в ссылку с сайта
BOT_USERNAME=teppa_pay_bot
# Telegram ID админов (через запятую) — получают уведомления и кнопки подтверждения
ADMIN_IDS=111111111,222222222

# ---- База данных (та же, что у сайта TEPPA) ----
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Сайт ----
# Куда возвращать покупателя после оплаты (return_url платёжных систем)
SITE_URL=https://teppa.uz

# ---- Payme (Merchant API) ----
# Секретный ключ кассы: Payme Merchant → «Ключи» (SECRET_KEY)
PAYME_MERCHANT_ID=MerchantId
PAYME_SECRET_KEY=SecretKey
# true — тестовая касса (test.paycom.uz)
PAYME_TEST=true

# ---- Click (Merchant API) ----
CLICK_SERVICE_ID=1234
CLICK_MERCHANT_ID=9999
CLICK_SECRET_KEY=secret

# ---- Оплата переводом на карту (работает без ключей) ----
CARD_NUMBER=8600 1234 5678 9012
CARD_HOLDER=TEPPA

# ---- Поведение ----
# Сколько минут держим место (как на сайте)
HOLD_MINUTES=12
# Сервисный сбор, добавляется к цене рейса (суммы)
SERVICE_FEE=990
# Цена обеда (суммы)
LUNCH_PRICE=100000
# ---- HTTP / вебхук Telegram ----
# Порт вебхука Payme/Click (на Render PORT задаёт сам, обычно 10000)
PORT=8080
HOST=0.0.0.0
# Пусто = локальный polling. Задано = апдейты приходят POST'ом на
# <URL>/telegram/webhook (нужен публичный https). На Render адрес подставляется
# автоматически из RENDER_EXTERNAL_URL — здесь ничего указывать не нужно.
TELEGRAM_WEBHOOK_URL=
# Секрет для заголовка X-Telegram-Bot-Api-Secret-Token (без пробелов и символов
# вне A-Za-z0-9_-). Если пусто — генерируется при старте процесса.
TELEGRAM_WEBHOOK_SECRET=
