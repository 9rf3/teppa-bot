# ============================================================
#  TEPPA bot — подключение за 5 минут
#
#  1. Скопируйте этот файл в .env:   cp .env.example .env
#  2. Заполните блок «Обязательное» — без него бот не стартует.
#  3. Заполните блок «Группа для чеков» — чтобы скриншоты оплат
#     падали в группу админов с ссылкой на пост.
#  4. Запустите:  .venv/bin/python main.py
# ============================================================


# ============================================================
#  ОБЯЗАТЕЛЬНОЕ
# ============================================================

# Токен бота — в Telegram: @BotFather → /newbot
BOT_TOKEN=123456:AA...
# Username бота без @ (подставляется в ссылку t.me/<bot>?start=pay_...)
BOT_USERNAME=teppa_pay_bot
# Telegram ID админов через запятую — получают уведомления и кнопки подтверждения
ADMIN_IDS=111111111,222222222

# Тот же проект Supabase, что у сайта (baland-trip). Ключ service_role —
# из Dashboard → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Куда возвращать покупателя после оплаты
SITE_URL=https://teppa.uz


# ============================================================
#  ГРУППА ДЛЯ ЧЕКОВ (Telegram)
#
#  Как подключить:
#  1. Создайте в Telegram группу (например «TEPPA — оплаты»)
#     и добавьте туда бота.
#  2. Напишите в группе любое сообщение.
#  3. Откройте в браузере (подставьте свой BOT_TOKEN):
#       https://api.telegram.org/bot<TOKEN>/getUpdates
#     Найдите «chat":{"id":-100XXXXXXXXXX — это и есть ID группы.
#  4. Впишите его ниже со знаком минус.
#
#  Что делает: покупатель присылает боту скриншот чека → фото ложится
#  в группу с кнопками «✅ Подтвердить / ❌ Отклонить» и ссылкой на пост
#  (ссылка видна в админке сайта, раздел «Платежи»). Если за 2 минуты
#  никто не отклонил — оплата подтверждается сама.
#
#  Пусто = чек каждому админу в ЛС (старый режим, тоже работает).
# ============================================================
ADMIN_GROUP_ID=

# Сколько секунд ждать решения перед авто-подтверждением (120 = 2 минуты)
RECEIPT_CHECK_SECONDS=120


# ============================================================
#  АДМИНКА САЙТА ↔ БОТ (по желанию)
#
#  Секрет одинаковый в двух местах: здесь и в .env сайта
#  (NUXT_BOT_INTERNAL_SECRET). Тогда в админке baland-trip → «Платежи»
#  кнопки «Подтвердить/Отклонить» работают напрямую с ботом.
#  Сгенерировать:  openssl rand -hex 16
# ============================================================
INTERNAL_SECRET=


# ============================================================
#  ПИСЬМА ПРИ ОТКЛОНЕНИИ ЧЕКА (по желанию)
#
#  Покупателю уходит email «оплата не подтверждена». Пусто = только
#  Telegram. Gmail: smtp.gmail.com, 587 и пароль приложения.
# ============================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=


# ============================================================
#  ПЛАТЁЖНЫЕ СИСТЕМЫ
#  Работают только когда заполнены ВСЕ ключи провайдера,
#  иначе способ просто не показывается в меню оплаты.
# ============================================================

# --- Payme (Merchant API) --- кабинет: https://merchants.payme.uz
# Песочница: PAYME_TEST=true → test.paycom.uz
PAYME_MERCHANT_ID=MerchantId
PAYME_SECRET_KEY=SecretKey
PAYME_TEST=true

# --- Click (SHOP API) --- кабинет: https://merchant.click.uz
CLICK_SERVICE_ID=1234
CLICK_MERCHANT_ID=9999
CLICK_SECRET_KEY=secret

# --- Перевод на карту (работает без ключей) ---
CARD_NUMBER=8600 1234 5678 9012
CARD_HOLDER=TEPPA


# ============================================================
#  ПОВЕДЕНИЕ И СЕТЬ (обычно менять не нужно)
# ============================================================

HOLD_MINUTES=12
SERVICE_FEE=990
LUNCH_PRICE=100000

# Порт HTTP-сервера (на Render PORT задаёт сам, обычно 10000)
HOST=0.0.0.0
PORT=8080

# Пусто = локальный polling. Задано = апдейты приходят POST'ом на
# <URL>/telegram/webhook (нужен публичный https). На Render подставляется
# автоматически из RENDER_EXTERNAL_URL — здесь указывать не нужно.
TELEGRAM_WEBHOOK_URL=
# Секрет X-Telegram-Bot-Api-Secret-Token (буквы, цифры, - и _).
# Пусто = генерируется при старте процесса.
TELEGRAM_WEBHOOK_SECRET=
